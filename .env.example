GOSSIPMEMO_DATABASE_PATH=/data/gossipmemo.db
GOSSIPMEMO_HOST=127.0.0.1
GOSSIPMEMO_PORT=8765
# Canonical name used for the fixed current user in prompts and projections.
GOSSIPMEMO_USER_NAME=CurrentUser

# Optional bearer token required from SDK clients.
GOSSIPMEMO_API_KEY=

# Required OpenAI-compatible chat-completions configuration.
# GossipMemo has no provider URL, model, or API-key fallback.
GOSSIPMEMO_LLM_BASE_URL=
GOSSIPMEMO_LLM_API_KEY=
GOSSIPMEMO_LLM_MODEL=
GOSSIPMEMO_LLM_TIMEOUT_SECONDS=120
GOSSIPMEMO_EXTRACTION_BATCH_SIZE=6
GOSSIPMEMO_EXTRACTION_BATCH_TIMEOUT_SECONDS=1800
GOSSIPMEMO_EXTRACTION_POLICY=balanced

# Structured application logs (production defaults to JSON at INFO).
GOSSIPMEMO_LOG_LEVEL=INFO
GOSSIPMEMO_LOG_FORMAT=json
