GOSSIPMEMO_DATABASE_PATH=/data/gossipmemo.db
GOSSIPMEMO_HOST=127.0.0.1
GOSSIPMEMO_PORT=8765

# Optional bearer token required from SDK clients.
GOSSIPMEMO_API_KEY=

# Required OpenAI-compatible chat-completions configuration.
# GossipMemo has no provider URL, model, or API-key fallback.
GOSSIPMEMO_LLM_BASE_URL=
GOSSIPMEMO_LLM_API_KEY=
GOSSIPMEMO_LLM_MODEL=
GOSSIPMEMO_LLM_TIMEOUT_SECONDS=120
